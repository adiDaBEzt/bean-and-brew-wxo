# Copy this file to .env. Keep .env and generated Snowflake keys private.

# Snowflake Enterprise lab account (use organization-account, without a URL).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_ADMIN_USER=
# Leave blank to enter the password at the bootstrap prompt.
SNOWFLAKE_ADMIN_PASSWORD=

# IBM Cloud watsonx Orchestrate. Paste the service instance URL and IAM key.
WXO_URL=
WXO_API_KEY=
# Set after importing the lab master agent.
WXO_MASTER_AGENT_ID=

# Loopback Keycloak development realm.
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=bean-brew
KEYCLOAK_CLIENT_ID=bb-web
# Generated by infra/keycloak/gen_realm.py.
KEYCLOAK_CLIENT_SECRET=
DEMO_USER_PASSWORD=
BFF_JWT_SECRET=
