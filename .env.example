# Environment Configuration Template for Bean & Brew
# Copy this file to .env and provide your actual secrets. NEVER commit .env!

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=your-account-id
SNOWFLAKE_ADMIN_USER=YOUR_ADMIN
SNOWFLAKE_ADMIN_PASSWORD=YourPassword

# Auto-generated by bootstrap.py (or specify your own)
SNOWFLAKE_BB_BARISTA_PASSWORD=
SNOWFLAKE_BB_MANAGER_PASSWORD=
SNOWFLAKE_BB_REGIONAL_PASSWORD=
SNOWFLAKE_BB_FINANCE_PASSWORD=
SNOWFLAKE_BB_HR_PASSWORD=

# --- IBM watsonx Orchestrate ---
WXO_URL=https://api.eu-de.watson-orchestrate.cloud.ibm.com/instances/<instance-id>
WXO_API_KEY=<your-ibm-iam-api-key>

# --- Keycloak (OIDC) ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=bean-brew
KEYCLOAK_CLIENT_ID=bb-web
KEYCLOAK_CLIENT_SECRET=
DEMO_USER_PASSWORD=

# --- BFF Backend ---
BFF_JWT_SECRET=super-secret-session-key-change-me
